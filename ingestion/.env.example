# Copy this file to .env and fill in real values. Never commit .env.
# See ingestion/README.md for step-by-step instructions on where to find
# each of these in the Supabase dashboard.

# --- Supabase REST API credentials (used by src/supabaseClient.ts) ---
# Supabase dashboard -> Settings -> API -> Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase dashboard -> Settings -> API -> Project API keys -> service_role
# (SECRET -- server-side only, bypasses Row Level Security. Never expose
# this in a browser / the web/ Next.js app.)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Direct Postgres connection (used by src/migrate.ts and src/sources/ncap.ts) ---
# Supabase dashboard -> Settings -> Database -> Connection string -> URI
# Use the Session pooler string (Supabase → Connect → Session pooler); the direct db.* host is IPv6-only.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# --- AutoScout24 Partner API (gated: requires approved partnership) ---
# See integrations/DATA_SOURCES.md section 1. Apply at autoscout24.github.io.
# Leave unset to skip AutoScout24 ingestion (the script exits cleanly).
AUTOSCOUT24_API_KEY=
# Optional: override if your partner docs specify a different API host.
AUTOSCOUT24_API_BASE_URL=

# --- mobile.de Data Feed API (gated: requires approved partnership) ---
# See integrations/DATA_SOURCES.md section 2. Contact partner@mobile.de.
# Leave unset to skip mobile.de ingestion (the script exits cleanly).
MOBILE_DE_API_KEY=
# Optional: override if your partner docs specify a different API host.
MOBILE_DE_API_BASE_URL=

# --- Euro NCAP CSV ingestion ---
# Path to a manually-downloaded results CSV from https://www.euroncap.com/en/results/
# Can also be passed per-run via: npm run ingest:ncap -- --file /path/to/file.csv
NCAP_CSV_PATH=
