# Copy this file to .env.local (and never commit .env.local).
#
# These are the browser-safe Supabase client credentials the web app will
# use later to READ data (listings, car_models, etc.) once someone wires up
# a Supabase client in this Next.js app. They are intentionally different
# from -- and much lower-privilege than -- the service-role key used by the
# ingestion/ project: the anon key is safe to ship to the browser because
# Supabase Row Level Security policies (not this key) are what actually
# restrict access.
#
# NOTE: this file only documents the variables. No Supabase client has been
# wired up in web/ yet -- that integration is a separate task for someone
# with full context on this app's current data layer (see web/src/lib/data.ts,
# which still powers the UI with a static mock dataset).

# Supabase dashboard -> Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase dashboard -> Settings -> API -> Project API keys -> anon / public
# (safe to expose in the browser; access is governed by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
